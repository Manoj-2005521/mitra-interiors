---
layout: layouts/base.njk
---

{% block extraCss %}
  <link rel="preload" href="/css/pages/portfolio-gallery.css" as="style" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="/css/pages/portfolio-gallery.css"></noscript>
{% endblock %}

<!-- PROJECTS HERO -->
<section class="projects-hero">
  <div class="wrap">
    <span class="eyebrow" style="color:var(--gold);">Gallery</span>
    <h1>
      <span>{{ title }}</span>
    </h1>
    <p>{{ description }}</p>
  </div>
</section>

<!-- PORTFOLIO SECTION -->
<section class="wrap portfolio-sec">
  <!-- Grid -->
  <div class="masonry reveal delay-1" id="portfolioGrid" style="margin-top:0;">
    {% for img in images %}
    <div class="p-card reveal in" style="cursor: default; transition-delay: {{ loop.index0 * 0.05 }}s;">
      {% if loop.index0 < 3 %}
        {% image img, title, "(max-width: 768px) 100vw, 33vw", "", "high" %}
      {% else %}
        {% image img, title, "(max-width: 768px) 100vw, 33vw", "", "lazy" %}
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <!-- Bottom Conversion Banner -->
  <div class="reveal" style="text-align: center; margin-top: 60px; padding: 48px 24px; background: var(--white); border-radius: var(--radius-lg); box-shadow: var(--shadow-card);">
    <span class="eyebrow" style="color: var(--gold); display: block; margin-bottom: 8px;">Bespoke Craftsmanship</span>
    <h3 style="font-family: var(--font-display); font-size: 32px; margin: 0 0 16px; color: var(--forest-deep);">Planning a {{ title }} Project?</h3>
    <p style="color: var(--slate); max-width: 540px; margin: 0 auto 28px; font-size: 15.5px; line-height: 1.6;">Schedule a free on-site survey. Our team provides an itemised, locked-cost specification within 48 hours.</p>
    <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
      <a href="/contact.html" class="btn btn-primary">Book Free Site Visit</a>
      <a href="https://wa.me/919876543210?text=Hi%20MITRA%20team,%20I%20am%20interested%20in%20a%20{{ title | urlencode }}%20project." class="btn btn-gold" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 8px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326z"/></svg>
        WhatsApp Consultation
      </a>
    </div>
  </div>
</section>
