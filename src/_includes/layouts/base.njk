<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default('MITRA Interior & Constructions') }}</title>
  <meta name="description" content="{{ description | default('MITRA Interior & Constructions designs and builds modular kitchens, wardrobes, home interiors, and full construction projects — with transparent, fixed pricing for every budget.') }}">
  
  <!-- SEO Open Graph -->
  <meta property="og:title" content="{{ title | default('MITRA Interior &amp; Constructions') }}">
  <meta property="og:description" content="{{ description | default('Bespoke interior design and construction services. Get high-end finishes, on-time delivery, and fixed transparent quotes.') }}">
  <meta property="og:type" content="{% if coverImage %}article{% else %}website{% endif %}">
  <meta property="og:url" content="https://www.mitrainteriors.in{{ page.url }}">
  <meta property="og:site_name" content="MITRA Interior &amp; Constructions">
  {% if coverImage %}
  <meta property="og:image" content="https://www.mitrainteriors.in/{{ coverImage }}">
  <meta name="twitter:image" content="https://www.mitrainteriors.in/{{ coverImage }}">
  {% else %}
  <meta property="og:image" content="https://www.mitrainteriors.in/images/brand/logo_512.png">
  <meta name="twitter:image" content="https://www.mitrainteriors.in/images/brand/logo_512.png">
  {% endif %}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | default('MITRA Interior &amp; Constructions') }}">
  <meta name="twitter:description" content="{{ description | default('Bespoke interior design and construction services.') }}">
  
  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Outfit:wght@300;400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </noscript>
  {% block preload %}{% endblock %}
  
  <!-- Anti-Flash Luxury Theme Bootstrapper -->
  <script>
    (function() {
      try {
        var stored = localStorage.getItem('mitra-theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored || (prefersDark ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.removeAttribute('data-theme');
        }
      } catch (e) {}
    })();
  </script>

  <!-- PWA & Assets -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2C2720">
  <link rel="apple-touch-icon" href="/images/brand/logo_192.png">
  <link rel="icon" type="image/png" href="/images/brand/logo_192.png">

  <!-- Critical CSS (Inlined for performance) -->
  <style>
    {{ "src/style.css" | inlineFile | safe }}
  </style>
  {% block extraCss %}{% endblock %}

  <!-- Canonical URL -->
  <link rel="canonical" href="https://www.mitrainteriors.in{{ page.url }}">

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://www.mitrainteriors.in/#organization",
        "name": "MITRA Interior & Constructions",
        "url": "https://www.mitrainteriors.in",
        "logo": "https://www.mitrainteriors.in/images/brand/logo.jpeg"
      },
      {
        "@type": "WebSite",
        "@id": "https://www.mitrainteriors.in/#website",
        "url": "https://www.mitrainteriors.in",
        "name": "MITRA Interior & Constructions",
        "publisher": {
          "@id": "https://www.mitrainteriors.in/#organization"
        }
      },
      {
        "@type": "LocalBusiness",
        "@id": "https://www.mitrainteriors.in/#localbusiness",
        "name": "MITRA Interior & Constructions",
        "url": "https://www.mitrainteriors.in",
        "image": "https://www.mitrainteriors.in/images/brand/logo.jpeg",
        "telephone": "+919876543210",
        "email": "hello@mitrainteriors.in",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Shaikpet Main Road",
          "addressLocality": "Hyderabad",
          "addressRegion": "Telangana",
          "postalCode": "500008",
          "addressCountry": "IN"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "17.4087",
          "longitude": "78.3978"
        },
        "areaServed": [
          {
            "@type": "State",
            "name": "Telangana"
          },
          {
            "@type": "State",
            "name": "Tamil Nadu"
          }
        ],
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
            "opens": "09:00",
            "closes": "19:00"
          }
        ],
        "sameAs": [
          "https://www.facebook.com/mitrainteriors",
          "https://www.instagram.com/mitrainteriors",
          "https://www.youtube.com/mitrainteriors"
        ],
        "priceRange": "$$$"
      }
    ]
  }
  </script>

  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    // Global Tracking Helper
    window.trackEvent = function(eventName, params) {
      if(typeof gtag === 'function') {
        gtag('event', eventName, params);
      }
    };
  </script>
  <noscript>
    <style>
      .reveal, .reveal-left, .reveal-right, .reveal-scale, .reveal-blur {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
      }
    </style>
  </noscript>
</head>
<body>

  <!-- Scroll Progress Indicator -->
  <div id="progress" aria-hidden="true"></div>

  {% include "components/header.njk" %}

  <main id="top">
    {{ content | safe }}
  </main>

  {% include "components/footer.njk" %}

  <!-- JavaScript -->
  <script src="/js/vendor/lucide.min.js" defer></script>
  <!-- Smooth Scroll (Lenis) -->
  <script src="/js/vendor/lenis.min.js" defer></script>
  <script type="module" src="/js/app.js"></script>
  
  {% block extraJs %}{% endblock %}
</body>
</html>
