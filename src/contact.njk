---
layout: layouts/base.njk
title: "Contact MITRA &mdash; Book a Free Consultation"
description: "Reach MITRA Interior &amp; Constructions. Book a free consultation visit, locate our design studio on maps, or chat on WhatsApp."
---

{% block extraCss %}
  <link rel="preload" href="/css/pages/contact.css" as="style" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="/css/pages/contact.css"></noscript>
{% endblock %}

<!-- CONTACT HERO -->
    <section class="contact-hero">
      <div class="wrap">
        <span class="eyebrow" style="color:var(--gold);">Say Hello</span>
        <h1>
          <span>Start your project</span><br>
          <span>journey today.</span>
        </h1>
        <p>Book a no-obligation visit. Our managers are ready to put your pricing ideas on paper.</p>
      </div>
    </section>

    <!-- CONTACT DETAILS & FORM -->
    <section class="wrap contact-page-sec">
      <div class="contact-grid">
        <!-- Details & Map Card -->
        <div class="studio-details-card reveal-left">
          <h3>Studio Coordinates</h3>
          
          <div class="c-item">
            <div class="ic"><i data-lucide="map-pin"></i></div>
            <div>
              <h4>Studio Location</h4>
              <p>MITRA Design Studio, Shaikpet Main Road, Hyderabad, Telangana</p>
            </div>
          </div>
          <div class="c-item">
            <div class="ic"><i data-lucide="clock"></i></div>
            <div>
              <h4>Office Hours</h4>
              <p>Monday &ndash; Saturday, 9:00 AM &ndash; 7:00 PM</p>
            </div>
          </div>
        </div>

        <!-- Consultation Form Card -->
        <div class="contact-form-card reveal-right">
          <span class="eyebrow" style="margin-bottom: 8px;">Reservation</span>
          <h3>Book Free Site Visit</h3>
          <p style="color:var(--slate); font-size:14.5px; opacity:0.8;">Get a fully itemised fixed quote within 48 hours of our survey visit.</p>
          
          <form id="contactForm" action="#" method="POST" novalidate aria-label="Contact Form">
            <!-- Honeypot for spam protection -->
            <div class="input-wrap visually-hidden" aria-hidden="true" style="display:none;">
              <input type="text" name="bot_field" id="bot_field" tabindex="-1">
            </div>

            <div class="form-row">
              <div class="input-wrap">
                <input type="text" id="formName" name="name" required placeholder="Full Name" minlength="2">
                <label for="formName" class="sr-only">Full Name</label>
              </div>
              <div class="input-wrap">
                <input type="tel" id="formPhone" name="phone" required placeholder="Phone Number" pattern="[0-9]{10}">
                <label for="formPhone" class="sr-only">Phone Number (10 digits)</label>
              </div>
            </div>

            <div class="form-row">
              <div class="input-wrap full">
                <input type="email" id="formEmail" name="email" required placeholder="Email Address">
                <label for="formEmail" class="sr-only">Email Address</label>
              </div>
            </div>

            <div class="form-row">
              <div class="input-wrap">
                <select id="formService" name="service" required aria-label="What kind of space are we crafting?">
                  <option value="">What kind of space are we crafting?</option>
                  <option value="Modular Kitchen">Modular Kitchen</option>
                  <option value="Wardrobes">Wardrobes</option>
                  <option value="Full Home Interiors">Full Home Interiors</option>
                  <option value="Construction / Renovation">Construction / Renovation</option>
                  <option value="Commercial Interiors">Commercial Interiors</option>
                </select>
              </div>
              <div class="input-wrap">
                <select id="formBudget" name="budget" required aria-label="Budget Range">
                  <option value="">Budget Range</option>
                  <option value="Under ₹2L">Under ₹2L</option>
                  <option value="₹2L &ndash; ₹5L">₹2L &ndash; ₹5L</option>
                  <option value="₹5L &ndash; ₹10L">₹5L &ndash; ₹10L</option>
                  <option value="₹10L+">₹10L+</option>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="input-wrap full">
                <textarea id="formMessage" name="message" placeholder="Tell us about your project..."></textarea>
                <label for="formMessage" class="sr-only">Project Details</label>
              </div>
            </div>
            <button type="submit" class="btn btn-primary" id="formSubmitBtn" style="width:100%; justify-content:center;">
              <span class="btn-text">Claim Your Free Site Survey &rarr;</span>
              <span class="btn-loader" style="display:none;" aria-hidden="true">Loading...</span>
            </button>
            <div class="form-trust-seal">
              <i data-lucide="shield-check"></i>
              <span>100% Fixed Price Guarantee &bull; No Hidden Site Fees &bull; Zero Obligation</span>
            </div>
          </form>
          <div id="formStatusMsg" class="toast-message" aria-live="polite"></div>
        </div>
      </div>

      <!-- Quick Contact Channels Grid -->
      <div class="quick-channels reveal-scale">
        <!-- WhatsApp -->
        <a href="https://wa.me/919876543210?text=Hi%20MITRA%20team,%20I%20would%20like%20to%20book%20a%20free%20design%20consultation%20and%20site%20visit." class="channel-btn" target="_blank" rel="noopener noreferrer">
          <span class="ic-c" style="color:#25D366"><i data-lucide="message-square"></i></span>
          <span class="lbl-c">Chat on WhatsApp</span>
          <span class="val-c">Instant replies within 15 min</span>
        </a>
        <!-- Call -->
        <a href="tel:+919876543210" class="channel-btn">
          <span class="ic-c" style="color:var(--forest)"><i data-lucide="phone"></i></span>
          <span class="lbl-c">Call Our Studio</span>
          <span class="val-c">+91 98765 43210</span>
        </a>
        <!-- Email -->
        <a href="mailto:hello@mitrainteriors.in" class="channel-btn">
          <span class="ic-c" style="color:var(--gold)"><i data-lucide="mail"></i></span>
          <span class="lbl-c">Send an Email</span>
          <span class="val-c">hello@mitrainteriors.in</span>
        </a>
      </div>
    </section>

    <!-- VISIT OUR STUDIO SECTION -->
    <section class="studio-sec" id="studio">
      <div class="wrap">
        <div class="sec-head center reveal-blur">
          <span class="eyebrow">Visit Our Studio</span>
          <h2>Experience materials, finishes, and personalized design consultations.</h2>
        </div>
        
        <div class="studio-map-container reveal-scale">
          <iframe 
            src="https://maps.google.com/maps?q=Shaikpet%20Main%20Road,%20Hyderabad,%20Telangana&t=&z=15&ie=UTF8&iwloc=&output=embed" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade" 
            title="MITRA Studio Shaikpet Location Map">
          </iframe>
          
          <div class="studio-card">
            <h4>MITRA Interior &amp; Constructions</h4>
            <div class="studio-card-details">
              <p>📍 &nbsp; <strong>Location:</strong> Shaikpet Main Road, Hyderabad, Telangana</p>
              <p>📞 &nbsp; <strong>Phone:</strong> +91 98765 43210</p>
              <p>✉ &nbsp; <strong>Email:</strong> hello@mitrainteriors.in</p>
              <p>🕘 &nbsp; <strong>Hours:</strong> Mon&ndash;Sat, 9:30 AM &ndash; 7:00 PM</p>
            </div>
            <a href="https://www.google.com/maps/dir/?api=1&destination=Shaikpet%20Main%20Road,%20Hyderabad,%20Telangana" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-directions">
              Get Directions &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>